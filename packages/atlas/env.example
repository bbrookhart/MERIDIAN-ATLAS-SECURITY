# Copy to .env for local (non-Docker) runs. docker-compose.yml sets its own
# values for the containerized services; this file documents them.

ATLAS_BUILD_SHA=dev
ATLAS_DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlas

ATLAS_OLLAMA_BASE_URL=http://localhost:11434
ATLAS_OLLAMA_CHAT_MODEL=llama3.2
ATLAS_OLLAMA_EMBED_MODEL=nomic-embed-text
ATLAS_EMBED_DIMENSIONS=768

# Optional hosted-API flag. Never hardcode a key — set it in the environment.
ATLAS_MODEL_PROVIDER=ollama
ATLAS_ANTHROPIC_API_KEY=
ATLAS_ANTHROPIC_MODEL=claude-sonnet-5

ATLAS_MCP_TICKETING_URL=http://localhost:8801/mcp
ATLAS_MCP_DOCSTORE_URL=http://localhost:8802/mcp

ATLAS_SEED=1337
ATLAS_CANARY_SEED=1337
ATLAS_REFUND_THRESHOLD_USD=500.0
ATLAS_OUTBOX_DIR=var/outbox
